<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<CS2ManagedPath>..\..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</CS2ManagedPath>
	</PropertyGroup>

	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<Reference Include="cohtml.Net">
			<HintPath>$(CS2ManagedPath)\cohtml.Net.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Colossal.Collections">
			<HintPath>$(CS2ManagedPath)\Colossal.Collections.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Game">
			<HintPath>$(CS2ManagedPath)\Game.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<HintPath>$(CS2ManagedPath)\Colossal.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<HintPath>$(CS2ManagedPath)\Colossal.Logging.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<HintPath>$(CS2ManagedPath)\Colossal.IO.AssetDatabase.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI">
			<HintPath>$(CS2ManagedPath)\Colossal.UI.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<HintPath>$(CS2ManagedPath)\Colossal.UI.Binding.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<HintPath>$(CS2ManagedPath)\Colossal.Localization.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<HintPath>$(CS2ManagedPath)\Unity.InputSystem.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(CS2ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<HintPath>$(CS2ManagedPath)\Unity.Burst.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<HintPath>$(CS2ManagedPath)\Unity.Collections.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<HintPath>$(CS2ManagedPath)\Unity.Entities.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<HintPath>$(CS2ManagedPath)\Unity.Mathematics.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>
</Project>